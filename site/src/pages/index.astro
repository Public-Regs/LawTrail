---
import Base from "../layouts/Base.astro";
import { getAllRegulations } from "../lib/data.js";
import { url } from "../lib/base.js";

const regulations = getAllRegulations();
---

<Base
  title="Daftar Peraturan"
  description="Arsip dan riwayat perubahan Peraturan Menteri Ketenagakerjaan."
>
  <link slot="head" rel="stylesheet" href={url("/pagefind/pagefind-ui.css")} />
  <h1>Peraturan Menteri Ketenagakerjaan</h1>
  <p class="disclaimer">
    Arsip ini dibangun otomatis dari peraturan.bpk.go.id (sumber utama) dan
    jdih.kemnaker.go.id (pembanding). Tanggal pengambilan data ada di setiap
    halaman detail — selalu bandingkan dengan sumber resmi. Baca{" "}
    <a href={url("/metodologi/")}>metodologi &amp; keterbatasan</a> arsip ini.
  </p>

  <p>{regulations.length} peraturan tersimpan.</p>

  <div id="pagefind-search"></div>
  {
    /* is:inline + <script src> biasa (bukan import()) supaya Vite tidak
    mencoba resolve file ini saat build -- baru ada setelah langkah
    postbuild (pagefind) jalan. 404 saat `astro dev` itu wajar/aman. */
  }
  <script is:inline src={url("/pagefind/pagefind-ui.js")}></script>
  <script is:inline>
    window.addEventListener("DOMContentLoaded", () => {
      if (window.PagefindUI) {
        new window.PagefindUI({ element: "#pagefind-search", showSubResults: true });
      }
    });
  </script>

  <ul class="reg-list" id="search-results">
    {
      regulations.map((reg) => (
        <li>
          <div class="reg-title">
            <a href={url(`/peraturan/${reg.id}/`)}>
              Permenaker No. {reg.nomor} Tahun {reg.tahun}
            </a>{" "}
            <span class={`badge ${reg.status === "Berlaku" ? "status-berlaku" : "status-lain"}`}>
              {reg.status}
            </span>
          </div>
          <div class="reg-meta">{reg.judul}</div>
        </li>
      ))
    }
  </ul>
</Base>
